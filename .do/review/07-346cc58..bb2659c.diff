+	['push(3, 4)', (list: unknown[]): unknown => list.push(3, 4)],
+	['push()', (list: unknown[]): unknown => list.push()],
+	['push(undefined)', (list: unknown[]): unknown => list.push(undefined)],
+	['batch push', (list: unknown[]): unknown => batch((): unknown => list.push(3))],
