# Ignore everything by default
*
*/

# Then explicitly allow what we want

# Folders
!.github/
!.github/**/
!.github/**/*.sh
!.github/**/*.yml
!.github/**/*.yaml
!assets/
!assets/*.png
!assets/*.svg
!docs/
!docs/**.md
!scripts/
!scripts/*.md
!scripts/*.?s
!src/
!src/
!src/*.ts
!src/*.md
!src/hooks/
!src/hooks/*.ts
!tests/
!tests/*.md
!tests/*.ts

# Files in root
!.gitattributes
!.gitignore
!.npmrc
!biome.json
!LICENSE
!mise.toml
!node.config.json
!package-lock.json
!package.json
!tsconfig.json
!tsconfig.lts.json

# Allow markdown anywhere
!**/*.md

# But still ignore these specific patterns everywhere
**/node_modules/**
*.tsbuildinfo
coverage/

*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
